model Project {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name           String
  domain         String @map("url")
  publicId       String @unique
  apiKeyHash     String
  apiKeyLastFour String

  // Environment value -> palette key for the board's env badge (e.g. { "prod": "red" }).
  environmentColors Json @default("{}")

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  widgetConfig    WidgetConfig?
  reviewers       Reviewer[]
  feedback        Feedback[]
  gitHubLink      ProjectGitHubLink?
  linearLink      ProjectLinearLink?
  jiraLink        ProjectJiraLink?
  slackLink       ProjectSlackLink?
  feedbackColumns FeedbackColumn[]
  domainRules     ProjectDomainRule[]

  @@index([organizationId])
  @@index([publicId])
  @@map("project")
}

model WidgetConfig {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  enabled Boolean @default(true)

  @@map("widget_config")
}

model Reviewer {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name     String
  token    String  @unique
  isActive Boolean @default(true)

  feedback Feedback[]

  @@index([projectId])
  @@map("reviewer")
}

model Feedback {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   Reviewer @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  status  String @default("new")
  comment String

  // Board lane (ADR-0010). Null means "first column of the status category";
  // when set, column.category always equals status.
  columnId String?
  column   FeedbackColumn? @relation(fields: [columnId], references: [id], onDelete: SetNull)
  pageUrl  String

  clickX   Float?
  clickY   Float?
  selector String?

  browserName    String?
  browserVersion String?
  os             String?
  viewportWidth  Int?
  viewportHeight Int?

  metadata Json?

  // Fixed at submission from the matched domain rule and the widget's `tags`
  // prop (ADR-0012); never rewritten when rules change.
  tags Json @default("{}")

  // Diagnostic Trail: console + network snapshot captured by the widget at
  // submission. Read lazily by the dashboard modal only; never selected on
  // the widget read path (kept out of the hot getFeedback query).
  diagnosticTrail Json?

  screenshotId String?
  screenshot   Asset?  @relation("FeedbackScreenshot", fields: [screenshotId], references: [id], onDelete: SetNull)

  // Screen recording: an optional short capture of the sequence that produced
  // the defect. Additive to `screenshot`, never a replacement — a report may
  // carry both, either, or neither. Kept as its own Asset FK rather than
  // overloading `screenshotId` so the two media have independent lifecycles,
  // caps, and MIME allow-lists.
  recordingId String?
  recording   Asset?  @relation("FeedbackRecording", fields: [recordingId], references: [id], onDelete: SetNull)

  assigneeId String?
  assignee   Member? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  issueLink       FeedbackIssueLink?
  linearIssueLink FeedbackLinearIssueLink?
  jiraIssueLink   FeedbackJiraIssueLink?
  slackMessage    FeedbackSlackMessage?

  @@index([projectId])
  @@index([reviewerId])
  @@index([assigneeId])
  @@map("feedback")
}

// A per-Project kanban lane layered over Feedback.status (ADR-0010). Category is
// one of the non-archived status literals and is immutable once created.
model FeedbackColumn {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name     String
  category String
  position Int

  feedback Feedback[]

  @@index([projectId, position])
  @@map("feedback_column")
}

// Extra allowed host pattern for a Project's widget (ADR-0012). The first rule by
// position that matches the request host allows it and supplies the Feedback's tags.
model ProjectDomainRule {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  pattern   String
  fixedTags Json   @default("{}")
  position  Int

  @@unique([projectId, pattern])
  @@index([projectId, position])
  @@map("project_domain_rule")
}
